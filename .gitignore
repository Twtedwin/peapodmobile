# =============================================================================
# Peapod monorepo -- ignore rules
# =============================================================================

# --- Secrets ---------------------------------------------------------------
# .env.example IS committed (it is the documented template); real .env files
# never are. The negation must come after the wildcard to take effect.
.env
.env.local
.env.*
**/.env
**/.env.local
**/.env.*
!.env.example
!**/.env.example

# Signing material. Committing any of these hands over the ability to
# impersonate the service or ship a build as you.
*.pem
*.p8
*.p12
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
service-account*.json


# --- Dependencies ----------------------------------------------------------
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
target/


# --- Build output ----------------------------------------------------------
dist/
build/
*.tsbuildinfo

# Expo and native build artefacts. `ios/` and `android/` are generated by
# `expo prebuild` and must stay out of git: the managed workflow regenerates
# them from app.config.ts, so a committed copy silently overrides your config.
# Match every folder level (`**/`) so a nested apps/mobile/android never ships.
.expo/
**/.expo/
.expo-shared/
android/
ios/
**/android/
**/ios/
**/android/**
**/ios/**
# Gradle local machine config + the Maps SDK key pasted there. Never commit.
local.properties
**/local.properties
*.apk
*.aab
*.ipa
*.jsbundle


# --- Generated code --------------------------------------------------------
# packages/shared/generated/ is produced by `npm run codegen` from the JSON
# Schemas. It IS committed, so that a Python or Rust build does not need Node
# installed, and so `npm run codegen:check` can prove the schemas and the
# generated models are in step. Do not add it here.


# --- Logs and coverage -----------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/


# --- Editor and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# --- Local scratch ---------------------------------------------------------
*.local
.cache/
tmp/
