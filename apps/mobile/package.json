{
  "name": "@peapod/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Peapod's Expo/React Native client. The only surface it talks to for data is services/api; every type, rule, threshold and algorithm it renders comes from @peapod/shared. Every dependency below ships inside Expo Go, so `npx expo start` works without a custom development client.",
  "main": "./index.ts",
  "scripts": {
    "//--- development ---": "`start` opens the Metro bundler; scan the QR code with Expo Go. `android`/`ios` do the same and then try to open an already-running emulator/simulator.",
    "start": "expo start --port 8083",
    "android": "expo start --android --port 8083",
    "ios": "expo start --ios --port 8083",
    "build:apk": "eas build -p android --profile preview --local",
    "test": "vitest run",
    "test:health": "vitest run test/api-client.test.ts",
    "//--- quality gates ---": "Run both before finishing any change. There is no build step - Metro compiles TypeScript directly - so `typecheck` is the only thing standing between a type error and a red screen on a phone.",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@peapod/shared": "*",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.2",
    "babel-preset-expo": "~57.0.11",
    "date-fns": "^4.1.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.34.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "3.0.5"
  }
}
