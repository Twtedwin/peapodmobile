# =============================================================================
# Peapod -- environment template
# =============================================================================
#
# Copy this file to `.env` and fill in what you need:
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.
#
# WHAT YOU ACTUALLY NEED TO GET STARTED
#   Nothing. Every value below has a working development default, and the app
#   runs end-to-end without a single external API key. Features that need a
#   third-party service degrade to a clearly-labelled fallback rather than
#   crashing -- one-time codes print to the console instead of being emailed,
#   maps use the platform default provider instead of Google, and the trip
#   planner uses its built-in generator instead of an LLM.
#
#   Everything you have to provision for a real deployment is documented step by
#   step in SETUP-EXTERNAL-APIS.md, including which items block app store review.
#
# WHICH SERVICE READS WHAT
#   Each block below is labelled with the service that consumes it. The mobile
#   app can ONLY read variables prefixed `EXPO_PUBLIC_`, and anything with that
#   prefix is embedded in the shipped app bundle where anyone can read it --
#   so a secret must never carry it.


# -----------------------------------------------------------------------------
# Database  [services/api, services/security]
# -----------------------------------------------------------------------------
# Both services share one Postgres instance but own separate tables: the API
# owns the domain schema, the security service owns the credential tables.
# Use ONE URL. The Python service rewrites `postgres://` / `postgresql://`
# onto `postgresql+asyncpg://` at boot. There is no `SECURITY_DATABASE_URL`.
DATABASE_URL=postgres://peapod:peapod_dev_password@localhost:5432/peapod


# -----------------------------------------------------------------------------
# Service topology  [all services]
# -----------------------------------------------------------------------------
# Local listen ports. The Node API process reads `PORT` (Render injects this
# automatically). `API_PORT` is not read by any service.
PORT=8080
API_PORT=8080
SECURITY_PORT=8081
COMPUTE_PORT=8082

# Where the API finds its siblings. Inside Docker these become service names
# (http://security:8081); natively they are 127.0.0.1. No trailing slash.
# On Render the API MUST set this to the public HTTPS origin of the Python
# service. Leaving the loopback default makes every /auth/* call return 503.
SECURITY_URL=http://127.0.0.1:8081
COMPUTE_URL=http://127.0.0.1:8082

# Set false to skip the Rust service entirely and always use the pure
# TypeScript fallback in services/api/src/compute/. The default is false so a
# first run does not need a Rust toolchain or a compute container. Flip to
# true after `docker compose up -d compute` if you want the Rust maths path.
COMPUTE_ENABLED=false

# Shared secret for service-to-service calls (the API asking the security
# service to verify a token). Generate a real one for any deployment:
#   openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=dev-only-insecure-internal-service-token

# Comma-separated allowed origins, or * in development. The Expo dev client
# connects from a LAN address that changes, hence the wildcard default.
CORS_ORIGINS=*


# -----------------------------------------------------------------------------
# Authentication  [services/security]
# -----------------------------------------------------------------------------
# Development uses a symmetric HS256 secret for simplicity. Production should
# use an RS256 key pair instead, so the API can verify tokens with only the
# public key and a leak of the API cannot mint tokens.
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#
# The service REFUSES TO START with this placeholder when ENVIRONMENT=production.
JWT_SECRET=dev-only-insecure-jwt-secret-do-not-use-in-production
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Access tokens are deliberately short-lived: a stolen one expires quickly.
# Refresh tokens last a month and are rotated on every use, so a stolen refresh
# token is detected the moment the real one is used again.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# One-time codes for registration and password reset.
OTP_TTL_SECONDS=600

# Dev/debug: store the six-digit OTP in otp_codes.code_hash as plaintext.
# Set false to restore Argon2 hashing (no schema change).
OTP_STORE_PLAINTEXT=true

# Switches on the production safety checks. Leave as development locally.
ENVIRONMENT=development


# =============================================================================
# EXTERNAL SERVICES -- all optional for local development.
# Full provisioning instructions: SETUP-EXTERNAL-APIS.md
# =============================================================================

# -----------------------------------------------------------------------------
# Google Maps Platform  [apps/mobile]   -- REQUIRED FOR LAUNCH
# -----------------------------------------------------------------------------
# Without a key the app falls back to the platform map available in Expo Go
# and still renders the pod markers and Carto-like dark treatment. Enable Maps
# SDK for Android and Maps SDK for iOS for native EAS builds.
#
# These are embedded in the shipped bundle, so restrict them by bundle
# identifier in the Google Cloud console -- that restriction IS the security
# boundary, not secrecy.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Server-side key for geocoding done by the API. Restrict this one by IP.
GOOGLE_MAPS_SERVER_API_KEY=


# -----------------------------------------------------------------------------
# Push notifications  [apps/mobile, services/api]   -- REQUIRED FOR LAUNCH
# -----------------------------------------------------------------------------
# Without these, notifications are in-app only: they appear when the app is
# open and are silently missed when it is closed.
EXPO_PUBLIC_EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=
# Android delivery via Firebase Cloud Messaging.
FCM_SERVICE_ACCOUNT_JSON=
# iOS delivery via Apple Push Notification service.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Transactional email  [services/security]   -- REQUIRED FOR LAUNCH
# -----------------------------------------------------------------------------
# BLOCKS REGISTRATION IN PRODUCTION. Without a provider, one-time codes and
# password reset links are printed to the security service's logs, which is
# fine locally and useless to a real user.
#
# Resend: EMAIL_FROM must use a verified domain (or, until then, Resend's
# onboarding sender `beth.t@example.com`, which only delivers to the account
# owner). An unverified `no-reply@peapod.app` is accepted by HTTP then dropped.
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_URL=https://api.resend.com/emails
EMAIL_FROM=Peapod <beth.t@example.com>
# Expo deep link into apps/mobile/app/reset-password.tsx (?token= is appended).
PASSWORD_RESET_URL=peapod://reset-password


# -----------------------------------------------------------------------------
# Google OAuth  [services/security]   -- REQUIRED FOR THE "SIGN IN WITH GOOGLE" BUTTON
# -----------------------------------------------------------------------------
# Email and password sign-in works without these; the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the API origin (this process proxies /auth/*). Not :8081.
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback
OAUTH_SUCCESS_REDIRECT_URL=peapod://auth/callback


# -----------------------------------------------------------------------------
# Object storage  [services/api]   -- REQUIRED FOR AVATARS AND MEMORY PHOTOS
# -----------------------------------------------------------------------------
# Any S3-compatible service works (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Without it, the upload endpoint returns 503 and the app keeps its placeholder
# images. R2 is the cheapest option for this workload because it charges no
# egress, and photo viewing is almost all egress.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=peapod-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for reading uploaded objects (a CDN domain, ideally).
S3_PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# LLM provider  [services/api]   -- REQUIRED FOR AI FEATURES
# -----------------------------------------------------------------------------
# Powers the Work It Out compromise proposals and upgrades the trip planner
# from its rule-based generator to genuine AI. Without a key, Work It Out uses
# locally-generated suggestions and says so in the response.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=


# -----------------------------------------------------------------------------
# Payments  [services/api, apps/mobile]   -- OPTIONAL
# -----------------------------------------------------------------------------
# The wallet is fully simulated and is labelled as such on every screen. Wiring
# a provider is a substantial regulated project, not a config change -- read the
# warning in SETUP-EXTERNAL-APIS.md before starting.
STRIPE_SECRET_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# Routing  [services/api]   -- OPTIONAL
# -----------------------------------------------------------------------------
# Snaps driving trip lines to real roads. Left unset, trip lines are drawn from
# the smoothed GPS trace, which is honest and works fine.
OSRM_URL=


# -----------------------------------------------------------------------------
# Mobile app  [apps/mobile]
# -----------------------------------------------------------------------------
# Where the app finds the API. For a physical phone in Expo Go this must be your
# machine's LAN address, NOT localhost -- the phone's localhost is the phone.
# Find it with `ipconfig` (Windows) or `ifconfig | grep inet` (macOS/Linux).
# Cloud preview APKs use https://peapod-api.onrender.com (see apps/mobile/eas.json).
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
# Optional. Derived automatically (http→ws, https→wss) when unset.
# EXPO_PUBLIC_WEBSOCKET_URL=wss://peapod-api.onrender.com

# Metro's default port is 8081, which is already the Python security service.
# Expo reads RCT_METRO_PORT when you do not pass --port.
RCT_METRO_PORT=8083
